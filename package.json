{
  "name": "kayaaan-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Kayaaan Clothing - data model & API layer (Next.js + Prisma). Storefront/admin UI to follow.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "db:migrate": "dotenv -e .env.local -- prisma migrate deploy",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "test:local": "dotenv -e .env.local -- vitest run",
    "build:local": "dotenv -e .env.local -- next build",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:rebuild": "node scripts/prepare-assets.mjs --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.10",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.10",
    "prisma": "^5.20.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
