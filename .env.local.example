# Local development database (docker-compose.yml).
#
# Copy to `.env.local` to point the app at local Postgres instead of Supabase:
#     cp .env.local.example .env.local
#
# Next.js loads `.env.local` ahead of `.env`, so the app picks this up with no
# other changes. The Prisma CLI does NOT read `.env.local` — the `db:*` scripts
# in package.json pass it explicitly via dotenv-cli. Use those, not bare
# `npx prisma ...`, or you will run migrations against production Supabase.
#
# `.env.local` is gitignored. Delete it to go back to Supabase.

DATABASE_URL="postgresql://kayaan:kayaan_local_dev@localhost:5433/kayaan"
DIRECT_URL="postgresql://kayaan:kayaan_local_dev@localhost:5433/kayaan"
